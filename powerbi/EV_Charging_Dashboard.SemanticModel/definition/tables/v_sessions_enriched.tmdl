table v_sessions_enriched
	lineageTag: 9d514076-c16c-4c4a-aa4d-420234d73e23

	measure Sessions = COUNTROWS(v_sessions_enriched)
		formatString: 0
		lineageTag: d0c95383-c189-4a5f-807c-ef0fddcc6b14

	measure 'Sessions per Charger' = DIVIDE([Sessions], DISTINCTCOUNT(v_sessions_enriched[charger_name]))
		lineageTag: 5fed5ef8-2b2b-44f1-a2bf-0b0c84d2ee20

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total kWh' = SUM(v_sessions_enriched[energy_kwh])
		lineageTag: 72efe070-29db-4839-814c-9b9260134cbf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median Minutes' = ```
			MEDIAN(v_sessions_enriched[charge_minutes])
			
			```
